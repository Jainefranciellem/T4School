DATABASE_URL="postgresql://t4school:t4school@localhost:5432/t4school?schema=public"
# Unpooled connection, used only for migrations. On Neon/Vercel Postgres this is the
# non-"-pooler" connection string; locally it's the same as DATABASE_URL.
DIRECT_URL="postgresql://t4school:t4school@localhost:5432/t4school?schema=public"
PORT=3333
CORS_ORIGIN="http://localhost:8080"

JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Shared secret required in the X-Internal-Secret header of POST /internal/jobs/reminders
INTERNAL_JOB_SECRET="change-me-internal-secret"
# Cron expression for the in-process reminder job (Docker/self-host only, default: every 15 minutes)
REMINDER_JOB_CRON="*/15 * * * *"
# Vercel-only: set this in the Vercel project env vars. Vercel Cron then sends it
# automatically as "Authorization: Bearer <value>" when it calls the reminders job.
CRON_SECRET=""

# JSON completo da chave de serviço do Firebase (Firebase Console > Configurações
# do projeto > Contas de serviço > Gerar nova chave privada). Necessário só pra
# enviar push pro professor no job de lembretes; sem isso o push só é pulado.
FIREBASE_SERVICE_ACCOUNT=''

# Used only by prisma/seed.ts to create the first admin user
SEED_ADMIN_EMAIL="admin@t4school.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Professor Carlos"
