{
  "buildCommand": "npx prisma generate && npx prisma migrate deploy && node scripts/build-vercel.mjs",
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/.prisma/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/internal/jobs/reminders", "schedule": "0 12 * * *" }
  ]
}
